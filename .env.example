COMPOSE_PROJECT_NAME="generic-agent-template"

# --- FastAPI Server Configuration ---
APP_HOST="0.0.0.0"
APP_PORT="8000"
DEBUG_MODE=true

# --- Arize Phoenix Monitoring Ports ---
PHOENIX_UI_PORT="6006"
PHOENIX_GRPC_PORT="4317"

# --- Monitoring Endpoints (Dynamic - derived from ports defined above) ---
PHOENIX_COLLECTOR_ENDPOINT="http://phoenix-server:${PHOENIX_GRPC_PORT}"
PHOENIX_UI_ENDPOINT="http://phoenix-server:${PHOENIX_UI_PORT}"

# --- LLM Provider Credentials ---
# Anthropic Claude API Key
CLAUDE_API_KEY="your_claude_api_key_here"

# Enterprise Custom Gateway Client Secret
SECURE_CLIENT_SECRET="your_enterprise_gateway_secret_here"
